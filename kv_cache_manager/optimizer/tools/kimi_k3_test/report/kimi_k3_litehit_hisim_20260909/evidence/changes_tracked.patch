+TEST_F(LiteHitOfflineRunnerTest, HybridCoarseningOnlyReusesCheckpointEndpoints) {
+    // Three native blocks match (12 tokens), but the last restorable
+    // checkpoint is at token 8. A radix split cannot synthesize token 12's state.
+    const std::string trace_path = WriteTrace(
+        "hybrid_coarse.jsonl",
+        {TraceLine("i1", "r1", 1000, {10, 20, 30, 40}, 17), TraceLine("i1", "r2", 2000, {10, 20, 30, 99}, 17)});
+    OptimizerLiteHitConfig config = MakeConfig(trace_path, GetTestTempRootPath());
+    auto group = MakeGroup();
+    group.set_enable_prefix_hash(true);
+    config.set_instance_groups({group});
+    config.set_instances(
+        {OptimizerInstanceInfo("g1",
+                               "i1",
+                               8,
+                               {LocationSpecInfo("kv", 32768), LocationSpecInfo("state", 49152)},
+                               {LocationSpecGroup("full", {"kv"}), LocationSpecGroup("linear", {"state"})},
+                               1,
+                               OptimizerStateInfo("full", "linear"))});
+    ASSERT_TRUE(LiteHitOfflineRunner(config).Run());
+    const auto lines = ReadLines(GetTestTempRootPath() + "/" + kLiteHitFactsFileName);
+    ASSERT_EQ(3, lines.size());
+    LiteHitFactRecord record;
+    std::string error;
+    ASSERT_TRUE(ParseLiteHitFactRow(lines[2], record, error)) << error;
+    EXPECT_EQ(8, record.block_size_tokens);
+    EXPECT_EQ(81920, record.block_bytes);
+    EXPECT_EQ(17, record.input_token_len);
+    EXPECT_EQ((std::vector<HitCurveSegment>{{1, 1}}), record.fact.hit_curve);
+}
