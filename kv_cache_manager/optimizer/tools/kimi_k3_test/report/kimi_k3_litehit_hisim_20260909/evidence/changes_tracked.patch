+TEST_F(LiteHitOfflineRunnerTest, HybridBundlesChargeBothKvAndEndpointState) {
+    const std::string trace_path = WriteTrace(
+        "hybrid.jsonl", {TraceLine("i1", "r1", 1000, {1, 2, 3}, 13), TraceLine("i1", "r2", 2000, {1, 2, 3}, 13)});
+    OptimizerLiteHitConfig config = MakeConfig(trace_path, GetTestTempRootPath());
+    config.set_instances(
+        {OptimizerInstanceInfo("g1",
+                               "i1",
+                               4,
+                               {LocationSpecInfo("kv", 16384), LocationSpecInfo("state", 49152)},
+                               {LocationSpecGroup("full", {"kv"}), LocationSpecGroup("linear", {"state"})},
+                               1,
+                               OptimizerStateInfo("full", "linear"))});
+    ASSERT_TRUE(LiteHitOfflineRunner(config).Run());
+    const std::string facts_path = GetTestTempRootPath() + "/" + kLiteHitFactsFileName;
+    const auto lines = ReadLines(facts_path);
+    ASSERT_EQ(3, lines.size());
+    LiteHitFactRecord record;
+    std::string error;
+    ASSERT_TRUE(ParseLiteHitFactRow(lines[2], record, error)) << error;
+    EXPECT_EQ(65536, record.block_bytes);
+    EXPECT_EQ((std::vector<HitCurveSegment>{{1, 3}}), record.fact.hit_curve);
+
+    // A capacity that fits KV but not its state must not hit. Exercise the
+    // byte boundary and infinite projection through the production query.
+    const double gib = 1024.0 * 1024.0 * 1024.0;
+    const std::string query_path = GetTestTempRootPath() + "/hybrid_query.jsonl";
+    ASSERT_TRUE(RunLiteHitFactsQuery(
+        facts_path, {16384.0 / gib, 65535.0 / gib, 65536.0 / gib, 196608.0 / gib, -1.0}, query_path, error))
+        << error;
+    const auto query_lines = ReadLines(query_path);
+    EXPECT_NE(std::string::npos, query_lines[1].find("\"hit_blocks\":[0,0,1,3,3]"));
+    EXPECT_NE(std::string::npos, query_lines.back().find("\"total_hit_tokens\":[0,0,4,12,12]"));
+    EXPECT_NE(std::string::npos, query_lines.back().find("\"total_input_tokens\":26"));
+}
