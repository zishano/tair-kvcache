+TEST_F(LiteHitOfflineRunnerTest, ReservedLastTokenLimitsHitsWithoutDroppingCommittedBlocks) {
+    const std::string trace_path = WriteTrace("reserve_last.jsonl",
+                                              {TraceLine("i1", "r1", 1000, {1, 2}, 8),
+                                               TraceLine("i1", "r2", 2000, {1, 2}, 8),
+                                               TraceLine("i1", "r3", 3000, {1, 2, 3}, 13)});
+    auto config = MakeConfig(trace_path, GetTestTempRootPath());
+    config.set_reserve_last_token(true);
+    OptimizerLiteHitConfig parsed;
+    ASSERT_TRUE(parsed.FromJsonString(config.ToJsonString()));
+    EXPECT_TRUE(parsed.reserve_last_token());
+    ASSERT_TRUE(LiteHitOfflineRunner(parsed).Run());
+    const auto lines = ReadLines(GetTestTempRootPath() + "/" + kLiteHitFactsFileName);
+    ASSERT_EQ(4, lines.size());
+    LiteHitFactRecord record;
+    std::string error;
+    ASSERT_TRUE(ParseLiteHitFactRow(lines[2], record, error)) << error;
+    EXPECT_EQ(8, record.input_token_len); // preserve the source length
+    EXPECT_EQ((std::vector<HitCurveSegment>{{1, 1}}), record.fact.hit_curve);
+    ASSERT_TRUE(ParseLiteHitFactRow(lines[3], record, error)) << error;
+    // Block 2 was committed even though r2 could not reuse it at its endpoint.
+    EXPECT_EQ((std::vector<HitCurveSegment>{{1, 2}}), record.fact.hit_curve);
+}
